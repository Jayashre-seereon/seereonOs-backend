# SeereonOS API configuration (Python FastAPI; same variable names as the former Node server). All optional unless
# marked. Docker compose: copy to .env at the repository root (cp backend/.env.example .env) and run docker compose up.

# --- runtime ---
# development | production | test   (NODE_ENV is still read when APP_ENV is not set)
APP_ENV=production
PORT=8000
HOST=0.0.0.0
# gunicorn worker processes per container (CPU-bound analytics: ~1 per vCPU)
WEB_CONCURRENCY=2
# process time zone: the shared business logic computes "today" in local time (tenants are in India)
TZ=Asia/Kolkata
# fatal | error | warn | info | debug | silent
LOG_LEVEL=info
# public URL of the web app (links in e-mails)
APP_URL=http://localhost:8000
# built frontend served with SPA fallback; empty = API only
STATIC_DIR=dist
# true behind a load balancer / reverse proxy (client IP from X-Forwarded-For)
TRUST_PROXY=false
# comma-separated exact origins allowed to call the API cross-origin; empty = same-origin only
CORS_ORIGINS=
SHUTDOWN_GRACE_MS=10000

# --- database (two roles, see backend/docs/database/README.md) ---
# owner: migrations, auth/platform tables, flush.  Production refuses the default/CHANGE_ME passwords.
DATABASE_URL=postgres://seereon_owner:CHANGE_ME@localhost:5432/seereonos
# app: tenant reads under RLS
DATABASE_APP_URL=postgres://seereon_app:CHANGE_ME@localhost:5432/seereonos
# connections per worker process (opened on demand): owner >= REQUEST_THREADS + 2, app >= REQUEST_THREADS.
# Across the fleet keep workers x (PG_POOL_MAX + PG_APP_POOL_MAX) under PostgreSQL max_connections (or use PgBouncer
# in transaction mode, see backend/PERFORMANCE.md)
PG_POOL_MAX=10
PG_APP_POOL_MAX=20
STATEMENT_TIMEOUT_MS=30000
# tenants kept in the per-process cache (LRU) and its byte budget (estimated row bytes, not RSS). Measured RSS per
# worker: ~85 MB idle, ~550-600 MB with one 150k-entry tenant cached, ~175 MB with 20 demo-sized tenants
# (backend/PERFORMANCE.md "Capacity")
TENANT_CACHE_MAX=50
TENANT_CACHE_MAX_MB=512

# --- performance (backend/PERFORMANCE.md "Tuning knobs") ---
# handler threads per worker process (CPU-bound Python: more threads only add GIL contention)
REQUEST_THREADS=4
# of those, how many may run writes at once; writes take the tenant lock first after a recent lost race (adaptive),
# never (optimistic) or always (pessimistic)
WRITE_THREADS=2
LEASE_MODE=adaptive
CONTENTION_WINDOW_S=10
# response memo per worker: GET responses reused while every table they read is unchanged (0 = off); TTL <= 60 s
MEMO_MAX_MB=64
MEMO_TTL_S=60
# tests only: every memo hit is also computed and compared (logs "response memo mismatch")
MEMO_VERIFY=false
# password hashes computed at once per worker (scrypt ~100 ms CPU + 32 MB each)
SCRYPT_CONCURRENCY=1
# server-side prepared statements after N runs per connection; off for PgBouncer (transaction mode) older than 1.21
PG_PREPARE_THRESHOLD=5
# other processes' writes are applied from the change log (table_changes) up to this many changed rows; more: re-read
DELTA_MAX_ROWS=2000
# gzip for responses >= this many bytes, at this level (1-9)
GZIP_MIN_BYTES=1024
GZIP_LEVEL=5
# gunicorn (gunicorn.conf.py): worker timeout / graceful shutdown / keep-alive / recycling (0 = never)
WORKER_TIMEOUT=120
GRACEFUL_TIMEOUT=20
KEEPALIVE=75
MAX_REQUESTS=0
MAX_REQUESTS_JITTER=0
# deep-freeze cached rows (default: on except APP_ENV=production) — makes illegal in-place mutations fail loudly
FREEZE_ROWS=

# --- security ---
SESSION_IDLE_HOURS=12
SESSION_ABSOLUTE_DAYS=30
# requests / minute / session token (or IP when signed out); counted per worker process in memory — a DoS guard,
# not a security boundary (the auth limits below are the shared, exact ones)
RATE_LIMIT_GLOBAL=600
# requests / minute / IP+e-mail (and 10x that per IP) on sign-in, second step, sign-up, password reset, invites.
# Counted in PostgreSQL (table rate_limits), so the limit holds across all processes and instances.
RATE_LIMIT_AUTH=10
# REQUIRED in production: key material (>= 32 chars) that seals two-step (TOTP) secrets at rest (AES-256-GCM),
# byte-compatible with the Node reference.   openssl rand -base64 48
# Rotate: move the old key to MFA_ENCRYPTION_KEY_PREVIOUS (comma-separated, still accepted for reading).
MFA_ENCRYPTION_KEY=CHANGE_ME_openssl_rand_base64_48
MFA_ENCRYPTION_KEY_PREVIOUS=
SECURITY_EVENTS_RETENTION_DAYS=400
# true: reset-request returns demo_token, POST /demo/reset restores demo data (refused when APP_ENV=production)
DEMO_MODE=false

# --- demo seed ---
# exported demo seed (backend/tools/export_seed.mjs); the Docker image bakes one at build time. Without it the API
# exports a fresh one when Node is installed (SEED_REGENERATE=auto|always|never).
SEED_JSON=
SEED_REGENERATE=auto
# docker entrypoint: apply migrations on start / seed an empty database
MIGRATE_ON_START=true
SEED_DEMO=false

# --- e-mail (outbox delivery) ---
# smtp(s)://user:pass@host:port — empty: messages stay in the outbox, nothing is sent
SMTP_URL=
MAIL_FROM=SeereonOS <no-reply@seereonos.com>

# --- docker compose only ---
# process time zone of the api container (compose reads SEEREON_TZ, not TZ, so a TZ exported in your shell cannot leak in)
SEEREON_TZ=Asia/Kolkata
POSTGRES_PASSWORD=CHANGE_ME
SEEREON_OWNER_PASSWORD=CHANGE_ME
SEEREON_APP_PASSWORD=CHANGE_ME
